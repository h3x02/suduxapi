# Template for the .env file.
# Copy to .env, then fill in real values.

# ── Deployment ──────────────────────────────────────────────────────────────
# "production" enables strict config validation (strong JWT secrets, real
# Resend key).
APP_ENV=production

# Server HTTP and WebSocket port.
APP_PORT=8080

# ── Database & Cache URLs ───────────────────────────────────────────────────
# Connection strings for PostgreSQL and Redis running locally or remotely.
DATABASE_URL=postgres://sudux:CHANGE_ME_strong_password@localhost:5432/sudux?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ── JWT secrets (required) ──────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
# In production, defaults/short values make the service refuse to start.
JWT_ACCESS_SECRET=CHANGE_ME_random_48_byte_string
JWT_REFRESH_SECRET=CHANGE_ME_random_48_byte_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ── Resend (transactional email) ────────────────────────────────────────────
# Required in production; the placeholder makes validation fail.
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=login@sudux.example

# ── Auth / rate limiting (optional, defaults shown) ─────────────────────────
AUTH_CODE_TTL=5m
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RESEND_COOLDOWN=60s
AUTH_MAX_REQUESTS_PER_EMAIL=5
AUTH_MAX_REQUESTS_PER_IP=20

# Set true ONLY once API traffic goes through a trusted reverse proxy that
# overwrites X-Forwarded-For. Until then keep false (rate limits use the peer
# address).
TRUST_PROXY_HEADERS=false

# ── Match lifecycle (optional, defaults shown) ──────────────────────────────
MATCH_MAX_DURATION=30m
DISCONNECT_GRACE=60s
ROOM_EVICT_AFTER=10m

# ── Anti brute-force move throttling (optional, defaults shown) ─────────────
MOVE_MIN_INTERVAL=250ms
WRONG_MOVE_COOLDOWN=2s
WRONG_MOVE_PENALTY=50
