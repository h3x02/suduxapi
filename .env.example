# Example Environment File for Sudux Backend
APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/sudux?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=dev-jwt-access-secret-key-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Replace re_xxxxxxxxx in your local environment with your real Resend API key.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

AUTH_CODE_TTL=5m
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RESEND_COOLDOWN=60s
AUTH_MAX_REQUESTS_PER_EMAIL=5
AUTH_MAX_REQUESTS_PER_IP=20
